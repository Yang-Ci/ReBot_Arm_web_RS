# Web server
PORT=3002
# Set to 1 to enable HTTPS (uses .certs/ self-signed)
HTTPS=0

# Text agent (LLM) proxy target
REBOTARM_TEXT_AGENT_URL=http://localhost:8082

# MCP proxy target
REBOTARM_MCP_URL=http://localhost:8081/mcp

# MotorBridge WebSocket (real-hardware direct control)
MOTORBRIDGE_WS_URL=ws://127.0.0.1:9002
MOTORBRIDGE_WS_TOKEN=
